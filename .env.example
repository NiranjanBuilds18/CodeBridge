# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ===================================================================
# SUPABASE CONFIGURATION (Free Plan)
# ===================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and keys:
#
# SUPABASE_URL: Project URL (e.g. https://your-project.supabase.co)
# IMPORTANT: Use the root Project URL. Do NOT append /rest/v1 or trailing slashes.
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Public Anon Key (safe to expose to client for Realtime)
SUPABASE_ANON_KEY="your-anon-key-here"

# SUPABASE_SERVICE_ROLE_KEY: Secret Service Role Key (SERVER-SIDE ONLY, NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# SUPABASE_STORAGE_BUCKET: Storage bucket for uploaded files (default: codebridge-files)
SUPABASE_STORAGE_BUCKET="codebridge-files"
